{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*/", "destination": "https://transaction-ledger-api-fdp4.onrender.com/api/:path*/" },
    { "source": "/api/:path*", "destination": "https://transaction-ledger-api-fdp4.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://transaction-ledger-api-fdp4.onrender.com/health" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
