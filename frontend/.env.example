# Origin for data requests. Leave empty to call the same origin
# (Vite proxies /api in dev; vercel.json rewrites /api to the backend in production).
VITE_API_URL=
# Public backend origin used for links people open directly (Swagger API docs).
# Falls back to VITE_API_URL. Example: https://transaction-ledger-api-fdp4.onrender.com
VITE_API_PUBLIC_URL=
